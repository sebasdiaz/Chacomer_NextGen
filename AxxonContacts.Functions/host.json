{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "AxxonContacts": "Information",
      "Microsoft.PowerPlatform": "Warning",
      "Azure.Messaging.ServiceBus": "Warning",
      "default": "Warning"
    }
  },
  "extensions": {
    "serviceBus": {
      "prefetchCount": 0,
      "maxAutoRenewDuration": "00:10:00",
      "messageHandlerOptions": {
        "maxConcurrentCalls": 1,
        "autoComplete": false
      }
    }
  }
}
