    {
      "name": "Dataverse",
      "description": "Busca contacts y accounts por `msdyn_identificationnumber`. Es el unico grupo cuyo origen no es una API externa, y el unico con forma de respuesta propia.\n\n**Solo lectura**: no crea, no actualiza y no publica mensajes.",
      "item": [
        {
          "name": "Consulta RUC (con DV)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "",
                  "pm.test('trae el sobre {ruc, cantidad, resultados}', function () {",
                  "    pm.expect(b.ruc).to.eql(pm.variables.get('ruc'));",
                  "    pm.expect(b.resultados).to.be.an('array');",
                  "    pm.expect(b.cantidad).to.eql(b.resultados.length);",
                  "});",
                  "",
                  "pm.test('el tipo de persona se corresponde con la tabla', function () {",
                  "    b.resultados.forEach(function (r) {",
                  "        pm.expect(r.tipoPersona).to.eql(r.entidad === 'account' ? 'Juridica' : 'Fisica');",
                  "    });",
                  "});",
                  "",
                  "// Un RUC devuelve el master mas los raws que cuelgan de el, uno por legal entity:",
                  "// varias filas es lo normal, una sola no significa que falte nada.",
                  "if (b.cantidad === 0) {",
                  "    console.warn('0 resultados: ese RUC no existe en el Dataverse del ambiente. No es un error del endpoint.');",
                  "} else {",
                  "    console.log('masters:', b.resultados.filter(r => r.esMaster).length, '| raws:', b.resultados.filter(r => !r.esMaster).length);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dataverse/consulta-ruc?ruc={{ruc}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dataverse",
                "consulta-ruc"
              ],
              "query": [
                {
                  "key": "ruc",
                  "value": "{{ruc}}",
                  "description": "Con digito verificador: matchea por igualdad exacta."
                }
              ]
            },
            "description": "Vienen los accounts primero y, dentro de cada tabla, el master antes que los raws. Tope de 50 por tabla."
          }
        },
        {
          "name": "Consulta RUC (sin DV, por prefijo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
