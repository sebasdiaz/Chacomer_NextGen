                  "pm.test('todo lo que vuelve arranca con el RUC pedido', function () {",
                  "    const prefijo = pm.variables.get('rucSinDv') + '-';",
                  "    b.resultados.forEach(function (r) {",
                  "        pm.expect(r.identificationNumber || '').to.satisfy(n => n.indexOf(prefijo) === 0);",
                  "    });",
                  "});"
                ]
