<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AxxonTicketAtencion.Functions</RootNamespace>
    <AssemblyName>AxxonTicketAtencion.Functions</AssemblyName>
    <Company>Axxon Consulting</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Azure Functions runtime (.NET isolated process). -->
    <!-- Solo HTTP: no consume Service Bus. -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />

    <!-- Relleno del template Word por Custom XML Part. Queda en la integracion y no en
         Axxon.Eip.Core a proposito: ninguna otra Function App genera documentos, y no
         tiene sentido arrastrar OpenXML al paquete de las otras seis. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Componentes cross de la EiP: Key Vault, telemetria, Dataverse Web API y Graph. -->
    <ProjectReference Include="..\..\..\core\Axxon.Eip.Core\Axxon.Eip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- El template DEBE viajar en el paquete: sin el, la function levanta bien y falla
         recien en la primera invocacion. El pipeline lo verifica en el publish output. -->
    <None Update="Templates\template_ticket_atencion.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
