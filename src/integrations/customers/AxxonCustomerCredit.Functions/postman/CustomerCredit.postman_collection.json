                  "pm.test('400 y dice que filtros acepta', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.include('Acepta');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/creditos/clientes?ruc=80054203-7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "creditos",
                "clientes"
              ],
              "query": [
                {
                  "key": "ruc",
                  "value": "80054203-7"
                }
              ]
            },
            "description": "Este endpoint no consulta por RUC. El que si lo hace es **Customer Data**, sobre Dataverse."
          }
        }
      ]
    }
  ]
}
