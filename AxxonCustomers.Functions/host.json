{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "AxxonCustomers": "Information",
      "Microsoft.PowerPlatform": "Warning",
      "Azure.Messaging.ServiceBus": "Warning",
      "default": "Warning"
    }
  },
  "extensions": {
    "serviceBus": {
      "prefetchCount": 0,
      "maxConcurrentCalls": 1,
      "autoCompleteMessages": false,
      "maxAutoLockRenewalDuration": "00:10:00"
    }
  }
}
